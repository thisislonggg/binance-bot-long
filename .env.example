# Password untuk login ke dashboard Radar P2P
DASHBOARD_PASSWORD=password_rahasia_anda

# String acak panjang untuk menandatangani session token (misal hasil openssl rand -hex 32)
DASHBOARD_SESSION_SECRET=string_acak_panjang_minimal_32_karakter

# Supabase (Database riwayat harga & transaksi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Binance API (Hanya butuh izin Read-Only / Enable Reading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
